[Unit]
Description=TMK Admin API (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=tmk-admin-api-%i
Group=tmk-admin-api-%i
EnvironmentFile=/etc/tmk-admin-api/%i.env
ExecStart=/opt/tmk-admin-api/%i/current/tmk-admin-api
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tmk-admin-api/%i
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
