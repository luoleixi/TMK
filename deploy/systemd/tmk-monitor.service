[Unit]
Description=TMK unified monitor API
After=network-online.target
Wants=network-online.target

[Service]
User=tmk-monitor
Group=tmk-monitor
ExecStart=/opt/tmk-monitor/current/tmk-monitor
EnvironmentFile=-/etc/tmk-monitor.env
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tmk-monitor /var/log/tmk

[Install]
WantedBy=multi-user.target
