[Unit]
Description=TMK Monitoring API (%i)
After=network-online.target prometheus.service
Wants=network-online.target

[Service]
Type=simple
User=tmk-monitor-%i
Group=tmk-monitor-%i
WorkingDirectory=/var/lib/tmk-monitor/%i
Environment=GIN_MODE=release
EnvironmentFile=/etc/tmk-monitor/%i.env
ExecStart=/opt/tmk-monitor/%i/current/tmk-monitor
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/tmk-monitor/%i

[Install]
WantedBy=multi-user.target
